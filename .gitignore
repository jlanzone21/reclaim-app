android/app/src/main/assets/capacitor.plugins.json

# Android signing — NEVER commit keystores or credentials
*.keystore
*.jks
android/keystore.properties

# Android Studio / IDE
android/.idea/
*.iml
android/local.properties

# OS junk
Thumbs.db
.DS_Store

# Build output artifacts (regeneratable, often large binaries)
*.apk
*.aab

# Local session/debug cruft
.claude/scheduled_tasks.lock
android/gradle_debug_out.txt
