{
  "manifest_version": 3,
  "name": "Reclaim — Browser Companion",
  "version": "0.1.0",
  "description": "Lets the Reclaim web app notice risky browsing patterns on this device and check in before a slip. Everything stays in this browser; nothing is ever sent anywhere.",
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "permissions": ["tabs", "storage", "unlimitedStorage", "idle", "alarms", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["https://reclaim128.org/*", "http://localhost:4173/*"],
      "js": ["lib/shared.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://reclaim128.org/*", "http://localhost:4173/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Reclaim — Browser Companion",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png"
    }
  }
}
