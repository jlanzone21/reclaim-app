<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Long-press the launcher icon -> "Preferences" (see res/xml/shortcuts.xml). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Notification access: special access, no runtime dialog — the
             user grants this manually via
             Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS (see
             NotificationAccessPlugin.java). Only ever records which app most
             recently posted a notification, never its text. -->
        <service
            android:name=".RecentNotificationListenerService"
            android:label="Reclaim"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Accessibility: special access, no runtime dialog — the user
             grants this manually via Settings.ACTION_ACCESSIBILITY_SETTINGS
             (see AccessibilityPlugin.java). System-wide as of Phase 4 —
             see accessibility_service_config.xml and PURPOSE.md. -->
        <service
            android:name=".TrackingAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Handles NightlyCheckinWorker's "Went well" action only — not exported, only ever
             triggered by this app's own PendingIntent. The other action launches MainActivity
             directly instead; see NightlyCheckinActionReceiver.java and NightlyCheckinWorker's
             class comment for why. -->
        <receiver
            android:name=".NightlyCheckinActionReceiver"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Special app-op permission: no runtime dialog exists for this one,
         the user must grant it manually via Settings.ACTION_USAGE_ACCESS_SETTINGS
         (see UsageStatsPlugin.java) -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Location: @capacitor/geolocation's own AAR manifest also declares
         these; listed explicitly too so they're visible here rather than
         only inside a dependency's merged-in manifest. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Background location ("Allow all the time") — lets the periodic
         sample (BaselineSampleWorker) get a fresh fix on its own schedule
         instead of depending on whatever some other app happened to cache
         last. Foreground access must already be granted before this can be
         requested at all; see LocationAlwaysPlugin.java. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Nearby devices: BLUETOOTH_SCAN (API 31+) is declared
         neverForLocation since NearbyDevicesPlugin only ever counts distinct
         devices seen during a short scan, never uses them for positioning —
         that flag is what lets us skip requiring ACCESS_FINE_LOCATION as a
         prerequisite on modern devices. BLUETOOTH/BLUETOOTH_ADMIN cover the
         legacy path below API 31, where BLE scanning has no permission of
         its own and relies on those plus ACCESS_FINE_LOCATION instead. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- Runtime-gated on API 33+ only, a no-op permission below that. Lets the periodic sample
         post local notifications: ForegroundAppMonitor's verification tool
         ("you've been on YouTube for an hour — is that correct?") and RiskNudgeMonitor's real
         risk-nudge notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Normal permission (no runtime dialog), but Android 14+ requires it be individually
         enabled via device Settings for anything other than calls/alarms, and may revoke it if
         a full-screen intent is posted too often without being used. Lets RiskNudgeMonitor's
         notification attempt to open the app immediately when the screen is off/locked, the same
         mechanism calls/alarms use — see that class's own doc comment for the honest limits on
         what this can and can't do. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Package visibility (API 30+): without this, PackageManager can't see other apps at all
         (not even to resolve a name/label) unless the app holds the restricted
         QUERY_ALL_PACKAGES permission, which requires special Play Store justification. This is
         the normal, unrestricted way to declare "this app needs to see other launchable apps" —
         needed for the allowlist picker (LocalSignalsPlugin.getInstalledApps) and for resolving
         labels of apps ForegroundAppMonitor/BaselineSampleWorker detect. Identity only (package
         name + label) either way — this declaration doesn't grant access to any app's content. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Separate from LAUNCHER above — queries visibility is granted per exact intent
             signature, not per action, so LocalSignalsDb.isLauncherPackage's HOME-intent
             resolution needs its own entry or it silently sees nothing and always returns false. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>
</manifest>
