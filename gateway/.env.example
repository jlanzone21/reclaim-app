# Copy to .env (gitignored) and set GATEWAY_API_KEYS. Generate a key with: openssl rand -hex 32
# Several keys can be listed (comma-separated) so one can be rotated without breaking installed apps.
GATEWAY_API_KEYS=

# Everything below is optional; defaults shown.
# HOST=127.0.0.1
# PORT=8787
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=reclaim-qwen
# LLM_API_KEY=
# ALLOWED_ORIGINS=https://reclaim128.org,https://www.reclaim128.org,https://localhost,http://localhost:4173,null
# SYSTEM_PROMPT_APPEND_FILE=prompt-append.txt
# MAX_OUTPUT_TOKENS=1024
# TEMPERATURE=0.2
# RATE_LIMIT_PER_MIN=20
# MAX_CONCURRENT=2
# MAX_QUEUE=6
# QUEUE_TIMEOUT_MS=20000
# UPSTREAM_TIMEOUT_MS=120000
# WARM_INTERVAL_MS=240000
# MAX_BODY_BYTES=1048576
# MAX_USER_CHARS=4000
# MAX_TOTAL_CHARS=32000
