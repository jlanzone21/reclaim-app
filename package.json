{
  "name": "reclaim",
  "version": "0.1.0",
  "description": "Reclaim — connects people struggling with pornography addiction to scripture, community, accountability, and counseling. Never a substitute for human connection.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "vendor:webllm": "node scripts/vendor-webllm.mjs",
    "vendor:youversion": "node scripts/vendor-youversion.mjs",
    "gen:icons": "node scripts/make-icons.mjs",
    "test:picker": "node scripts/test-resource-picker.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "sharp": "^0.35.4"
  },
  "build": {
    "appId": "com.reclaim.app",
    "productName": "Reclaim",
    "files": [
      "main.js",
      "web/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@capacitor/geolocation": "^8.2.2",
    "@mlc-ai/web-llm": "0.2.85",
    "@youversion/platform-core": "2.15.0",
    "sql.js": "^1.14.2"
  }
}
